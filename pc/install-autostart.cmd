@echo off
setlocal
chcp 65001 >nul
cd /d "%~dp0"

set "SHIM=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\MuMuLinkAgent.cmd"
set "OLD_LNK=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\MuMuLinkAgent.lnk"
set "TARGET=%~dp0start-agent.cmd"

echo 正在为当前用户安装登录自启（无需管理员）...
> "%SHIM%" echo @echo off
>> "%SHIM%" echo rem MuMuLink Agent autostart - generated by install-autostart.cmd
>> "%SHIM%" echo start "" /min "%TARGET%"
if not exist "%SHIM%" (
  echo [ERROR] 写入失败：%SHIM%
  echo 请确认当前用户对 Startup 目录有写权限。
  if not defined MUMULINK_NO_PAUSE pause
  exit /b 1
)
if exist "%OLD_LNK%" del /f /q "%OLD_LNK%" >nul 2>nul

echo.
echo 已安装：%SHIM%
echo 下次登录 Windows 时会最小化启动 MuMuLink Agent。
echo 卸载请运行 uninstall-autostart.cmd（或删除上述文件）。
if not defined MUMULINK_NO_PAUSE pause
